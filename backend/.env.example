# Copy this file to .env and fill in your values. Never commit .env.

# SQLAlchemy URL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/spend_tracker?charset=utf8mb4

# Long random string used to sign tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
